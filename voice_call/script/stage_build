#!/usr/bin/env bash
# Copy what the image needs but git does not carry into local/, for the
# Dockerfile: the models (int8 Parakeet CTC and TDT, Piper, speaker ID, wake
# words, the Kaldi verifier's model and tools, GLiNER for the command
# fallback, other languages' when present) and wyoming-wake-kaldi, which
# is not published. The Kaldi tools and its daemon are native binaries: stage
# them on (or for) the architecture you build for.
#
#   script/stage_build [--embedding]      # --embedding: also EmbeddingGemma 2 (hints by meaning)
set -euo pipefail
cd "$(dirname "$0")/.."
KALDI_SRC="${WYOMING_WAKE_KALDI:-$HOME/opt/wyoming-wake-kaldi}"

rm -rf local
mkdir -p local/models/speech-to-phrase
cp -a models/speech-to-phrase/stt_en_parakeet_tdt_ctc_110m-int8 local/models/speech-to-phrase/
cp -a models/parakeet-tdt-int8 models/piper models/speaker models/wake \
      models/wake-kaldi-models models/wake-kaldi-tools models/wake-kaldi-decoderd local/models/
# The multilingual TDT model (640 MB), when it has been put in models/: the
# sherpa-onnx release sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8, as is.
if [[ -d models/parakeet-tdt-v3-int8 ]]; then
    cp -a models/parakeet-tdt-v3-int8 local/models/
fi
# The other languages (`language: de`, `nl` ...), each when it has been put in
# models/: NVIDIA's FastConformer hybrid as int8 CTC and transducer (about 350
# MB a language), from scripts/export_nemo_hybrid.py. Their Piper voices come
# with models/piper. Until other languages are downloaded, they ship in the
# image.
for lang in de nl fr es; do
    name="stt_${lang}_fastconformer_hybrid_large_pc"
    if [[ -d "models/speech-to-phrase/$name-int8" ]]; then
        cp -a "models/speech-to-phrase/$name-int8" local/models/speech-to-phrase/
        cp -a "models/$name-transducer-int8" local/models/
    fi
done
# The command fallback's default model (78 MB), from scripts/export_gliner.py.
if [[ -d models/gliner2.5-small-v1-onnx ]]; then
    cp -a models/gliner2.5-small-v1-onnx local/models/
else
    echo "no models/gliner2.5-small-v1-onnx: the command fallback has no model (scripts/export_gliner.py)" >&2
fi

mkdir -p local/wyoming-wake-kaldi
cp -a "$KALDI_SRC/pyproject.toml" "$KALDI_SRC/wyoming_wake_kaldi" local/wyoming-wake-kaldi/
find local -name __pycache__ -prune -exec rm -rf {} +

if [[ "${1:-}" == "--embedding" ]]; then
    snapshot="$(ls -d "$HOME"/.cache/huggingface/hub/models--onnx-community--embeddinggemma-2-ONNX/snapshots/* | tail -1)"
    mkdir -p local/models/embeddinggemma-2/onnx
    cp -L "$snapshot/tokenizer.json" local/models/embeddinggemma-2/
    cp -L "$snapshot"/onnx/model_q4.onnx* local/models/embeddinggemma-2/onnx/
fi
du -sh local/models local/wyoming-wake-kaldi
