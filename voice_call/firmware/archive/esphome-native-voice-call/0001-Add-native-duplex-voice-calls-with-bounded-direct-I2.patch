+# Call-only prototype. Hardware wiring follows the official VPE package at
+# d4e6fa43d6a1a7d342b7d4d403567e06516719de; no legacy VA or media writers are loaded.
+esphome:
+  name: voice-call-vpe
+  friendly_name: Voice Call VPE
+  on_boot:
+    priority: 375
+    then:
+      - delay: 1s
+      - switch.turn_on: internal_speaker_amp
+      - lambda: id(call_speaker).set_volume(0.5f);
+
+esp32:
+  board: esp32-s3-devkitc-1
+  variant: esp32s3
+  cpu_frequency: 240MHz
+  flash_size: 16MB
+  framework:
+    type: esp-idf
+    sdkconfig_options:
+      CONFIG_ESP32S3_DATA_CACHE_64KB: "y"
+      CONFIG_ESP32S3_DATA_CACHE_LINE_64B: "y"
+      CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB: "y"
+      CONFIG_SPIRAM_RODATA: "y"
+      CONFIG_SPIRAM_FETCH_INSTRUCTIONS: "y"
+
+psram:
+  mode: octal
+  speed: 80MHz
+  ignore_not_found: false
+
+logger:
+  hardware_uart: USB_SERIAL_JTAG
+
+# Provision Wi-Fi over Improv Serial, or add ssid/password using local secrets.
+wifi:
+improv_serial:
+api:
+  encryption:
+ota:
+  - platform: esphome
+
+i2c:
+  id: internal_i2c
+  sda: GPIO5
+  scl: GPIO6
+  frequency: 400kHz
+
+external_components:
+  - source:
+      type: git
+      url: https://github.com/esphome/home-assistant-voice-pe
+      ref: d4e6fa43d6a1a7d342b7d4d403567e06516719de
+    components: [voice_kit]
+
+# Keep the installed stock XMOS firmware; do not perform a DSP firmware update.
+voice_kit:
+  id: voice_kit_component
+  i2c_id: internal_i2c
+  reset_pin: GPIO4
+  channel_0_stage: AGC
+  channel_1_stage: NS
+
+audio_dac:
+  - platform: aic3204
+    id: call_dac
+    i2c_id: internal_i2c
+
+i2s_audio:
+  - id: call_input
+    i2s_lrclk_pin: GPIO14
+    i2s_bclk_pin: GPIO13
+  - id: call_output
+    i2s_lrclk_pin: GPIO7
+    i2s_bclk_pin: GPIO8
+
+microphone:
+  - platform: i2s_audio
+    id: call_mics
+    i2s_audio_id: call_input
+    i2s_din_pin: GPIO15
+    adc_type: external
+    pdm: false
+    sample_rate: 16000
+    bits_per_sample: 32bit
+    i2s_mode: secondary
+    channel: stereo
+
+speaker:
+  - platform: i2s_audio
+    id: call_speaker
+    i2s_audio_id: call_output
+    i2s_dout_pin: GPIO10
+    dac_type: external
+    sample_rate: 48000
+    bits_per_sample: 32bit
+    i2s_mode: secondary
+    channel: stereo
+    timeout: never
+    buffer_duration: 100ms
+    audio_dac: call_dac
+
+switch:
+  - platform: gpio
+    id: internal_speaker_amp
+    pin: GPIO47
+    restore_mode: ALWAYS_OFF
+    internal: true
+
+binary_sensor:
+  - platform: gpio
+    id: hardware_mute
+    pin: GPIO3
+    trigger_on_initial_state: true
+    on_press:
+      - microphone.mute: call_mics
+      - voice_call.stop: call
+      - light.turn_on:
+          id: call_leds
+          red: 100%
+          green: 0%
+          blue: 0%
+    on_release:
+      - microphone.unmute: call_mics
+      - light.turn_off: call_leds
+  - platform: gpio
+    id: call_button
+    pin:
+      number: GPIO0
+      inverted: true
+    on_press:
+      - if:
+          condition:
+            voice_call.is_running: call
+          then:
+            - voice_call.stop: call
+          else:
+            - if:
+                condition:
+                  binary_sensor.is_off: hardware_mute
+                then:
+                  - voice_call.start: call
+
+power_supply:
+  - id: led_power
+    pin: GPIO45
+
+light:
+  - platform: esp32_rmt_led_strip
+    id: call_leds
+    pin: GPIO21
+    num_leds: 12
+    rgb_order: GRB
+    bit0_high: 300ns
+    bit0_low: 975ns
+    bit1_high: 650ns
+    bit1_low: 650ns
+    reset_low: 300us
+    reset_high: 0us
+    rmt_symbols: 192
+    power_supply: led_power
+    default_transition_length: 0ms
+
+micro_wake_word:
+  id: call_wake_word
+  microphone:
+    microphone: call_mics
+    channels: 1
+    gain_factor: 4
+  stop_after_detection: false
+  models:
+    - model: https://github.com/kahrendt/microWakeWord/releases/download/okay_nabu_20241226.3/okay_nabu.json
+    - model: https://github.com/kahrendt/microWakeWord/releases/download/stop/stop.json
+      id: call_stop_model
+      internal: true
+  vad:
+
+voice_call:
+  id: call
+  microphone:
+    microphone: call_mics
+    channels: 1
+  speaker: call_speaker
+  micro_wake_word: call_wake_word
+  stop_wake_word: Stop
+  on_start:
+    - micro_wake_word.enable_model: call_stop_model
+  on_end:
+    - micro_wake_word.disable_model: call_stop_model
+    - if:
+        condition:
+          binary_sensor.is_off: hardware_mute
+        then:
+          - light.turn_off: call_leds
+  on_feedback:
+    - if:
+        condition:
+          binary_sensor.is_off: hardware_mute
+        then:
+          - light.turn_on:
+              id: call_leds
+              red: 0%
+              green: !lambda "return listening ? 1.0f : 0.0f;"
+              blue: !lambda "return processing ? 1.0f : 0.0f;"
+              brightness: 40%
+  on_error:
+    - logger.log:
+        format: "Voice call: %s"
+        args: [reason]
