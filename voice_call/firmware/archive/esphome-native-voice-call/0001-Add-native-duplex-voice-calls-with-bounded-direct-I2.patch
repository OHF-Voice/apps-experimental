+import asyncio
+from collections.abc import Generator
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+import esphome.codegen as cg
+from esphome.components import voice_call
+import esphome.config_validation as cv
+from esphome.core import CORE, ID
+from esphome.cpp_generator import MockObj
+import esphome.final_validate as fv
+from esphome.types import ConfigType
+
+
+@pytest.fixture
+def config() -> ConfigType:
+    return {
+        "id": ID("call"),
+        "microphone": {"microphone": ID("mic")},
+        "speaker": ID("output"),
+    }
+
+
+@pytest.fixture
+def full_config() -> Generator[MagicMock]:
+    full = MagicMock()
+    declarations = {
+        "mic": {"id": ID("mic", is_declaration=True), "i2s_audio_id": ID("input_bus")},
+        "output": {
+            "id": ID("output", is_declaration=True),
+            "i2s_audio_id": ID("output_bus"),
+            "timeout": "never",
+            "bits_per_sample": 32,
+            "sample_rate": 48000,
+            "num_channels": 2,
+        },
+        "wake": {"stop_after_detection": False},
+    }
+    full.get_path_for_id.side_effect = lambda value: [value.id, "id"]
+    full.get_config_for_path.side_effect = lambda path: declarations[path[0]]
+    full.items.return_value = []
+    full.get.return_value = []
+    token = fv.full_config.set(full)
+    with (
+        patch.object(
+            voice_call.microphone,
+            "final_validate_microphone_source_schema",
+            return_value=lambda value: value,
+        ),
+        patch.object(
+            voice_call.audio,
+            "final_validate_audio_schema",
+            return_value=lambda value: value,
+        ),
+    ):
+        yield full
+    fv.full_config.reset(token)
+
+
+def test_native_format_inherited(config: ConfigType, full_config: MagicMock) -> None:
+    validated = voice_call._final_validate(config)
+    assert validated["sample_rate"] == 48000
+    assert validated["num_channels"] == 2
+    assert voice_call.CONFLICTS_WITH == ["voice_assistant"]
+
+
+@pytest.mark.parametrize(
+    ("field", "value", "message"),
+    [
+        ("timeout", "500ms", "timeout: never"),
+        ("bits_per_sample", 24, "16- or 32-bit"),
+        ("sample_rate", 96000, "16000 to 48000"),
+        ("i2s_audio_id", ID("input_bus"), "separate I2S buses"),
+    ],
+)
+def test_unsupported_routes(
+    config: ConfigType, full_config: MagicMock, field: str, value: object, message: str
+) -> None:
+    full_config.get_config_for_path(["output"])[field] = value
+    with pytest.raises(cv.Invalid, match=message):
+        voice_call._final_validate(config)
+
+
+def test_media_writer_rejected(config: ConfigType, full_config: MagicMock) -> None:
+    full_config.items.return_value = [
+        ("media_player", [{"announcement_pipeline": {"speaker": ID("output")}}])
+    ]
+    with pytest.raises(cv.Invalid, match="exclusively owned speaker"):
+        voice_call._final_validate(config)
+
+
+def test_shared_speaker_bus_rejected(
+    config: ConfigType, full_config: MagicMock
+) -> None:
+    full_config.get.return_value = [
+        {"id": ID("second_output"), "i2s_audio_id": ID("output_bus")}
+    ]
+    with pytest.raises(cv.Invalid, match="exclusively owned output I2S bus"):
+        voice_call._final_validate(config)
+
+
+def test_stop_model_requires_live_detector(
+    config: ConfigType, full_config: MagicMock
+) -> None:
+    config["stop_wake_word"] = "Stop"
+    with pytest.raises(cv.Invalid, match="micro_wake_word reference"):
+        voice_call._final_validate(config)
+    config["micro_wake_word"] = ID("wake")
+    full_config.get_config_for_path(["wake"])["stop_after_detection"] = True
+    with pytest.raises(cv.Invalid, match="stop_after_detection: false"):
+        voice_call._final_validate(config)
+
+
+def test_codegen_constructor_and_callbacks(config: ConfigType) -> None:
+    config.update(
+        sample_rate=48000,
+        num_channels=2,
+        micro_wake_word=ID("wake"),
+        stop_wake_word="Stop",
+        on_start=[{}],
+        on_end=[{}],
+        on_feedback=[{}],
+        on_error=[{}],
+    )
+    var = MockObj("call")
+    source = MockObj("source")
+    output = MockObj("output")
+    wake = MockObj("wake")
+    with (
+        patch.object(
+            voice_call.microphone,
+            "microphone_source_to_code",
+            AsyncMock(return_value=source),
+        ),
+        patch.object(cg, "get_variable", AsyncMock(side_effect=[output, wake])),
+        patch.object(cg, "new_Pvariable", return_value=var) as create,
+        patch.object(cg, "register_component", AsyncMock()),
+        patch.object(
+            voice_call.automation, "build_callback_automation", AsyncMock()
+        ) as build,
+    ):
+        asyncio.run(voice_call.to_code(config))
+    create.assert_called_once_with(config["id"], source, output, 48000, 2)
+    assert [call.args[1] for call in build.call_args_list] == [
+        "add_on_start_callback",
+        "add_on_end_callback",
+        "add_on_feedback_callback",
+        "add_on_error_callback",
+    ]
+    assert "USE_VOICE_CALL" in {define.name for define in CORE.defines}
