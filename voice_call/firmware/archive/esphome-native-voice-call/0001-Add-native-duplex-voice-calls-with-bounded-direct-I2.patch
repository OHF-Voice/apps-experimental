diff --git a/esphome/components/voice_call/__init__.py b/esphome/components/voice_call/__init__.py
new file mode 100644
index 0000000000..69470bced6
--- /dev/null
+++ b/esphome/components/voice_call/__init__.py
@@ -0,0 +1,181 @@
+from collections.abc import Iterator
+from typing import Any
+
+from esphome import automation
+import esphome.codegen as cg
+from esphome.components import audio, micro_wake_word, microphone
+from esphome.components.i2s_audio import CONF_I2S_AUDIO_ID
+from esphome.components.i2s_audio.speaker import I2SAudioSpeaker
+import esphome.config_validation as cv
+from esphome.const import (
+    CONF_BITS_PER_SAMPLE,
+    CONF_ID,
+    CONF_MICROPHONE,
+    CONF_NEVER,
+    CONF_NUM_CHANNELS,
+    CONF_ON_ERROR,
+    CONF_ON_START,
+    CONF_SAMPLE_RATE,
+    CONF_SPEAKER,
+    CONF_TIMEOUT,
+)
+from esphome.core import ID
+import esphome.final_validate as fv
+from esphome.types import ConfigType
+
+AUTO_LOAD = ["audio"]
+DEPENDENCIES = ["api", "microphone", "speaker"]
+CONFLICTS_WITH = ["voice_assistant"]
+CODEOWNERS = ["@synesthesiam"]
+
+CONF_MICRO_WAKE_WORD = "micro_wake_word"
+CONF_STOP_WAKE_WORD = "stop_wake_word"
+CONF_ON_END = "on_end"
+CONF_ON_FEEDBACK = "on_feedback"
+
+voice_call_ns = cg.esphome_ns.namespace("voice_call")
+VoiceCall = voice_call_ns.class_("VoiceCall", cg.Component)
+
+CONFIG_SCHEMA = cv.All(
+    cv.Schema(
+        {
+            cv.GenerateID(): cv.declare_id(VoiceCall),
+            cv.Required(CONF_MICROPHONE): microphone.microphone_source_schema(),
+            cv.Required(CONF_SPEAKER): cv.use_id(I2SAudioSpeaker),
+            cv.Optional(CONF_MICRO_WAKE_WORD): cv.use_id(micro_wake_word.MicroWakeWord),
+            cv.Optional(CONF_STOP_WAKE_WORD): cv.All(
+                cv.string_strict, cv.Length(min=1, max=95)
+            ),
+            cv.Optional(CONF_ON_START): automation.validate_automation({}),
+            cv.Optional(CONF_ON_END): automation.validate_automation({}),
+            cv.Optional(CONF_ON_FEEDBACK): automation.validate_automation({}),
+            cv.Optional(CONF_ON_ERROR): automation.validate_automation({}),
+        }
+    ).extend(cv.COMPONENT_SCHEMA),
+    cv.only_on_esp32,
+    cv.only_with_framework("esp-idf"),
+)
+
+
+def _ids(value: Any) -> Iterator[ID]:
+    if isinstance(value, ID):
+        yield value
+    elif isinstance(value, dict):
+        for item in value.values():
+            yield from _ids(item)
+    elif isinstance(value, list):
+        for item in value:
+            yield from _ids(item)
+
+
+def _declaration(value: ID) -> ConfigType:
+    full = fv.full_config.get()
+    return full.get_config_for_path(full.get_path_for_id(value)[:-1])
+
+
+def _final_validate(config: ConfigType) -> ConfigType:
+    microphone.final_validate_microphone_source_schema("voice_call", sample_rate=16000)(
+        config[CONF_MICROPHONE]
+    )
+    output = _declaration(config[CONF_SPEAKER])
+    source = _declaration(config[CONF_MICROPHONE][CONF_MICROPHONE])
+    if output.get(CONF_TIMEOUT) != CONF_NEVER:
+        raise cv.Invalid("voice_call requires the dedicated speaker's timeout: never")
+    if output[CONF_BITS_PER_SAMPLE] not in (16, 32):
+        raise cv.Invalid("voice_call requires standard I2S with 16- or 32-bit slots")
+    if not 16000 <= output[CONF_SAMPLE_RATE] <= 48000:
+        raise cv.Invalid(
+            "voice_call supports speaker sample rates from 16000 to 48000 Hz"
+        )
+    if source.get(CONF_I2S_AUDIO_ID) == output[CONF_I2S_AUDIO_ID]:
+        raise cv.Invalid("voice_call microphone and speaker require separate I2S buses")
+    audio.final_validate_audio_schema(
+        "voice_call",
+        audio_device=CONF_SPEAKER,
+        bits_per_sample=16,
+        channels=output[CONF_NUM_CHANNELS],
+        sample_rate=output[CONF_SAMPLE_RATE],
+    )(config)
+    # A second producer could restart output after cancellation or corrupt the frame accounting.
+    full = fv.full_config.get()
+    for domain, fragment in full.items():
+        if domain in ("voice_call", "speaker"):
+            continue
+        if any(
+            not value.is_declaration and value == config[CONF_SPEAKER]
+            for value in _ids(fragment)
+        ):
+            raise cv.Invalid("voice_call requires an exclusively owned speaker")
+    for other in full.get("speaker", []):
+        if (
+            other[CONF_ID] != config[CONF_SPEAKER]
+            and other.get(CONF_I2S_AUDIO_ID) == output[CONF_I2S_AUDIO_ID]
+        ):
+            raise cv.Invalid("voice_call requires an exclusively owned output I2S bus")
+        if any(
+            not value.is_declaration and value == config[CONF_SPEAKER]
+            for value in _ids(other)
+        ):
+            raise cv.Invalid("voice_call speaker cannot also feed a mixer or resampler")
+    if (wake_id := config.get(CONF_MICRO_WAKE_WORD)) is not None:
+        wake = _declaration(wake_id)
+        if wake[micro_wake_word.CONF_STOP_AFTER_DETECTION]:
+            raise cv.Invalid(
+                "voice_call requires micro_wake_word stop_after_detection: false"
+            )
+    elif CONF_STOP_WAKE_WORD in config:
+        raise cv.Invalid("stop_wake_word requires a micro_wake_word reference")
+    config[CONF_SAMPLE_RATE] = output[CONF_SAMPLE_RATE]
+    config[CONF_NUM_CHANNELS] = output[CONF_NUM_CHANNELS]
+    return config
+
+
+FINAL_VALIDATE_SCHEMA = _final_validate
+
+
+async def to_code(config: ConfigType) -> None:
+    source = await microphone.microphone_source_to_code(config[CONF_MICROPHONE])
+    output = await cg.get_variable(config[CONF_SPEAKER])
+    var = cg.new_Pvariable(
+        config[CONF_ID],
+        source,
+        output,
+        config[CONF_SAMPLE_RATE],
+        config[CONF_NUM_CHANNELS],
+    )
+    await cg.register_component(var, config)
+    if (wake_id := config.get(CONF_MICRO_WAKE_WORD)) is not None:
+        cg.add(var.set_micro_wake_word(await cg.get_variable(wake_id)))
+    if (phrase := config.get(CONF_STOP_WAKE_WORD)) is not None:
+        cg.add(var.set_stop_wake_word(phrase))
+    for key, method, args in (
+        (CONF_ON_START, "add_on_start_callback", []),
+        (CONF_ON_END, "add_on_end_callback", []),
+        (
+            CONF_ON_FEEDBACK,
+            "add_on_feedback_callback",
+            [(cg.bool_, "listening"), (cg.bool_, "processing")],
+        ),
+        (CONF_ON_ERROR, "add_on_error_callback", [(cg.const_char_ptr, "reason")]),
+    ):
+        for conf in config.get(key, []):
+            await automation.build_callback_automation(var, method, args, conf)
+    cg.add_define("USE_VOICE_CALL")
+
+
+ACTION_SCHEMA = automation.maybe_simple_id({cv.GenerateID(): cv.use_id(VoiceCall)})
+automation.register_apply_action(
+    "voice_call.start", ACTION_SCHEMA, automation.ApplyCall("start()")
+)
+automation.register_apply_action(
+    "voice_call.stop", ACTION_SCHEMA, automation.ApplyCall("stop()")
+)
+automation.register_apply_action(
+    "voice_call.cancel_output", ACTION_SCHEMA, automation.ApplyCall("cancel_output()")
+)
+automation.register_apply_condition(
+    "voice_call.is_running", ACTION_SCHEMA, "is_running()"
+)
+automation.register_apply_condition(
+    "voice_call.connected", ACTION_SCHEMA, "is_connected()"
+)
diff --git a/esphome/components/voice_call/audio_buffer.h b/esphome/components/voice_call/audio_buffer.h
new file mode 100644
index 0000000000..92d9ae0ada
--- /dev/null
+++ b/esphome/components/voice_call/audio_buffer.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+namespace esphome::voice_call {
+
+// Single-owner, frame-aligned storage. The microphone caller supplies its own lock.
+template<size_t Capacity> class AudioBuffer {
+ public:
+  void reset(size_t frame_bytes) {
+    this->head_ = 0;
+    this->size_ = 0;
+    this->received_frames_ = 0;
+    this->consumed_frames_ = 0;
+    this->frame_bytes_ = frame_bytes;
+  }
+
+  bool append(const uint8_t *data, size_t size) {
+    if (this->frame_bytes_ == 0 || size % this->frame_bytes_ != 0 || size > Capacity - this->size_ ||
+        size / this->frame_bytes_ > std::numeric_limits<uint64_t>::max() - this->received_frames_)
+      return false;
+    const size_t tail = (this->head_ + this->size_) % Capacity;
+    const size_t first = std::min(size, Capacity - tail);
+    if (first != 0)
+      std::memcpy(this->data_.data() + tail, data, first);
+    if (size > first)
+      std::memcpy(this->data_.data(), data + first, size - first);
+    this->size_ += size;
+    this->received_frames_ += size / this->frame_bytes_;
+    return true;
+  }
+
+  bool consume(size_t size) {
+    if (this->frame_bytes_ == 0 || size > this->size_ || size % this->frame_bytes_ != 0)
+      return false;
+    this->head_ = (this->head_ + size) % Capacity;
+    this->size_ -= size;
+    this->consumed_frames_ += size / this->frame_bytes_;
+    return true;
+  }
+
+  const uint8_t *data() const { return this->data_.data() + this->head_; }
+  size_t contiguous_size() const { return std::min(this->size_, Capacity - this->head_); }
+  size_t size() const { return this->size_; }
+  uint64_t received_frames() const { return this->received_frames_; }
+  uint64_t consumed_frames() const { return this->consumed_frames_; }
+  uint64_t max_frames() const {
+    const uint64_t capacity_frames = Capacity / this->frame_bytes_;
+    return this->consumed_frames_ > std::numeric_limits<uint64_t>::max() - capacity_frames
+               ? std::numeric_limits<uint64_t>::max()
+               : this->consumed_frames_ + capacity_frames;
+  }
+
+ protected:
+  std::array<uint8_t, Capacity> data_{};
+  size_t head_{0};
+  size_t size_{0};
+  size_t frame_bytes_{2};
+  uint64_t received_frames_{0};
+  uint64_t consumed_frames_{0};
+};
+
+}  // namespace esphome::voice_call
diff --git a/esphome/components/voice_call/voice_call.cpp b/esphome/components/voice_call/voice_call.cpp
new file mode 100644
index 0000000000..c62d07e38e
--- /dev/null
+++ b/esphome/components/voice_call/voice_call.cpp
@@ -0,0 +1,386 @@
+#include "voice_call.h"
+#ifdef USE_VOICE_CALL
+
+#include "esphome/core/application.h"
+#include "esphome/core/log.h"
+
+#include <limits>
+
+namespace esphome::voice_call {
+
+static const char *const TAG = "voice_call";
+static constexpr uint32_t START_TIMEOUT_MS = 5000;
+static constexpr uint32_t OUTPUT_TIMEOUT_MS = 10000;
+
+VoiceCall *global_voice_call = nullptr;
+
+static void copy_reason(std::array<char, 96> &buffer, StringRef value) {
+  const size_t size = value.copy(buffer.data(), buffer.size() - 1);
+  buffer[size] = '\0';
+}
+
+VoiceCall::VoiceCall(microphone::MicrophoneSource *microphone, i2s_audio::I2SAudioSpeaker *speaker,
+                     uint32_t sample_rate, uint8_t channels)
+    : microphone_(microphone), speaker_(speaker), output_format_(16, channels, sample_rate) {
+  global_voice_call = this;
+}
+
+void VoiceCall::setup() {
+  this->microphone_->add_data_callback([this](const std::vector<uint8_t> &data) {
+    LockGuard lock(this->microphone_mutex_);
+    if (this->capture_enabled_ && !this->microphone_buffer_.append(data.data(), data.size()))
+      this->microphone_overflow_ = true;
+  });
+#ifdef USE_MICRO_WAKE_WORD
+  if (this->wake_word_ != nullptr) {
+    this->wake_word_->add_wake_word_detected_callback([this](const std::string &phrase) {
+      if (!this->stop_wake_word_.empty() && this->stop_wake_word_ == phrase) {
+        this->cancel_output_(StringRef("stop-wake-word"), true);
+      } else if (!this->is_running()) {
+        this->request_start_(StringRef(phrase));
+      }
+    });
+    this->wake_word_->start();
+  }
+#endif
+}
+
+void VoiceCall::dump_config() {
+  ESP_LOGCONFIG(TAG, "Voice Call:\n  Microphone: 16000 Hz, 16-bit mono\n  Output: %" PRIu32 " Hz, %u channels",
+                this->output_format_.get_sample_rate(), this->output_format_.get_channels());
+}
+
+void VoiceCall::get_capabilities(api::VoiceCallCapabilities &capabilities) const {
+  if (this->is_failed())
+    return;
+  capabilities.feature_flags = 1;
+  capabilities.version = 1;
+  capabilities.max_audio_bytes = MAX_AUDIO_BYTES;
+  capabilities.output_formats[0].sample_rate = this->output_format_.get_sample_rate();
+  capabilities.output_formats[0].channels = this->output_format_.get_channels();
+  capabilities.output_formats[0].width = 2;
+}
+
+void VoiceCall::subscribe(api::APIConnection *client, const api::VoiceCallSubscribeRequest &msg) {
+  if (!msg.subscribe) {
+    this->disconnected(client);
+    return;
+  }
+  if (msg.version != 1 || (this->client_ != nullptr && this->client_ != client) || this->is_running()) {
+    ESP_LOGW(TAG, "Call subscription refused");
+    return;
+  }
+  this->client_ = client;
+}
+
+void VoiceCall::disconnected(api::APIConnection *client) {
+  if (this->client_ != client)
+    return;
+  this->client_ = nullptr;
+  this->stop_(StringRef("disconnected"));
+}
+
+void VoiceCall::start() { this->request_start_(StringRef()); }
+void VoiceCall::stop() { this->stop_(StringRef("local-stop")); }
+void VoiceCall::cancel_output() { this->cancel_output_(StringRef("local-cancel"), true); }
+void VoiceCall::on_shutdown() { this->stop_(StringRef("shutdown")); }
+
+void VoiceCall::report_error_(const char *reason) {
+  ESP_LOGE(TAG, "%s", reason);
+  this->error_callback_.call(reason);
+}
+
+void VoiceCall::request_start_(StringRef wake_word) {
+  if (this->is_running())
+    return;
+  if (this->microphone_->get_mute_state()) {
+    this->report_error_("microphone-muted");
+    return;
+  }
+  if (this->client_ == nullptr || this->is_failed()) {
+    this->report_error_("not-connected");
+    return;
+  }
+  if (this->call_id_ == std::numeric_limits<uint64_t>::max()) {
+    this->report_error_("call-id-exhausted");
+    return;
+  }
+  this->call_id_++;
+  this->output_id_ = 0;
+  this->output_present_ = false;
+  this->start_sent_ = false;
+  copy_reason(this->wake_phrase_, wake_word);
+  {
+    LockGuard lock(this->microphone_mutex_);
+    this->microphone_buffer_.reset(2);
+    this->microphone_overflow_ = false;
+    this->capture_enabled_ = true;
+  }
+  this->state_ = CallState::CALL_STATE_STARTING;
+  this->started_at_ = App.get_loop_component_start_time();
+  this->microphone_progress_at_ = this->started_at_;
+  this->microphone_->start();
+}
+
+bool VoiceCall::matches_(uint64_t call_id) const { return this->is_running() && call_id == this->call_id_; }
+
+bool VoiceCall::matches_output_(uint64_t call_id, uint64_t output_id) const {
+  return this->matches_(call_id) && this->output_present_ && output_id == this->output_id_;
+}
+
+void VoiceCall::on_start_response(const api::VoiceCallStartResponse &msg) {
+  if (!this->matches_(msg.call_id) || this->state_ != CallState::CALL_STATE_STARTING || !this->start_sent_)
+    return;
+  if (!msg.accepted) {
+    this->stop_(msg.reason.empty() ? StringRef("rejected") : msg.reason);
+    return;
+  }
+  this->state_ = CallState::CALL_STATE_ACTIVE;
+  this->start_callback_.call();
+}
+
+void VoiceCall::stop_microphone_() {
+  {
+    LockGuard lock(this->microphone_mutex_);
+    this->capture_enabled_ = false;
+    this->microphone_buffer_.reset(2);
+  }
+  this->microphone_->stop();
+}
+
+void VoiceCall::stop_(StringRef reason) {
+  if (!this->is_running() || this->state_ == CallState::CALL_STATE_STOPPING)
+    return;
+  copy_reason(this->stop_reason_, reason);
+  this->state_ = CallState::CALL_STATE_STOPPING;
+  this->stop_microphone_();
+  this->cancel_output_(reason, false);
+  this->feedback_callback_.call(false, false);
+}
+
+void VoiceCall::on_stop(const api::VoiceCallStop &msg) {
+  if (this->matches_(msg.call_id))
+    this->stop_(msg.reason);
+}
+
+void VoiceCall::on_output_start(const api::VoiceCallOutputStart &msg) {
+  if (!this->matches_(msg.call_id) || this->state_ != CallState::CALL_STATE_ACTIVE)
+    return;
+  if (this->output_present_ && (msg.output_id <= this->output_id_ || !(this->terminal_sent_ && this->output_eof_))) {
+    this->report_error_("invalid-output-sequence");
+    this->stop_(StringRef("invalid-output-sequence"));
+    return;
+  }
+  this->output_id_ = msg.output_id;
+  this->output_present_ = true;
+  this->output_eof_ = false;
+  this->output_cancelling_ = false;
+  this->cancel_pending_ = false;
+  this->finish_requested_ = false;
+  this->terminal_sent_ = false;
+  this->terminal_state_ = api::enums::VOICE_CALL_OUTPUT_UNKNOWN;
+  this->output_reason_[0] = '\0';
+  this->granted_frames_ = 0;
+  this->rendered_frames_ = 0;
+  this->last_rendered_ = 0;
+  this->output_buffer_.reset(this->output_format_.frames_to_bytes(1));
+  this->output_progress_at_ = App.get_loop_component_start_time();
+  if (msg.width != 2 || msg.channels != this->output_format_.get_channels() ||
+      msg.sample_rate != this->output_format_.get_sample_rate()) {
+    this->cancel_output_(StringRef("unsupported-format"), false, true);
+    return;
+  }
+  if (!this->speaker_->begin_call_output()) {
+    this->cancel_output_(StringRef("speaker-unavailable"), false, true);
+    return;
+  }
+  this->renderer_owned_ = true;
+  this->speaker_->set_audio_stream_info(this->output_format_);
+  this->speaker_->start();
+}
+
+void VoiceCall::on_output_audio(const api::VoiceCallOutputAudio &msg) {
+  if (!this->matches_output_(msg.call_id, msg.output_id) || this->output_cancelling_ || this->terminal_sent_)
+    return;
+  const size_t frame_bytes = this->output_format_.frames_to_bytes(1);
+  const uint64_t frames = msg.data_len / frame_bytes;
+  if (this->output_eof_ || msg.data_len == 0 || msg.data_len > MAX_AUDIO_BYTES || msg.data_len % frame_bytes != 0 ||
+      this->output_buffer_.received_frames() > this->granted_frames_ ||
+      frames > this->granted_frames_ - this->output_buffer_.received_frames() ||
+      !this->output_buffer_.append(msg.data, msg.data_len)) {
+    this->cancel_output_(StringRef("invalid-output-audio"), true, true);
+    return;
+  }
+  this->output_progress_at_ = App.get_loop_component_start_time();
+}
+
+void VoiceCall::on_output_end(const api::VoiceCallOutputEnd &msg) {
+  if (this->matches_output_(msg.call_id, msg.output_id))
+    this->output_eof_ = true;
+}
+
+void VoiceCall::cancel_output_(StringRef reason, bool notify, bool error) {
+  if (!this->output_present_ || this->terminal_sent_ || this->output_cancelling_)
+    return;
+  this->output_cancelling_ = true;
+  this->cancel_pending_ = notify;
+  copy_reason(this->output_reason_, reason);
+  this->terminal_state_ = error ? api::enums::VOICE_CALL_OUTPUT_ERROR : api::enums::VOICE_CALL_OUTPUT_STOPPED;
+  if (this->renderer_owned_)
+    this->speaker_->stop();
+  if (error)
+    this->report_error_(this->output_reason_.data());
+}
+
+void VoiceCall::on_output_cancel(const api::VoiceCallOutputCancel &msg) {
+  if (this->matches_output_(msg.call_id, msg.output_id))
+    this->cancel_output_(msg.reason, false);
+}
+
+void VoiceCall::on_feedback(const api::VoiceCallFeedback &msg) {
+  if (this->matches_(msg.call_id) && this->state_ == CallState::CALL_STATE_ACTIVE)
+    this->feedback_callback_.call(msg.listening, msg.processing);
+}
+
+void VoiceCall::loop_output_() {
+  if (!this->output_present_ || this->terminal_sent_)
+    return;
+  const uint32_t now = App.get_loop_component_start_time();
+  if (this->renderer_owned_) {
+    const uint32_t rendered = this->speaker_->get_call_frames_played();
+    if (rendered != this->last_rendered_) {
+      this->rendered_frames_ += static_cast<uint32_t>(rendered - this->last_rendered_);
+      this->last_rendered_ = rendered;
+      this->output_progress_at_ = now;
+    }
+    if (this->speaker_->call_output_failed())
+      this->cancel_output_(StringRef("speaker-error"), true, true);
+  }
+  if (!this->output_cancelling_ && now - this->output_progress_at_ > OUTPUT_TIMEOUT_MS)
+    this->cancel_output_(StringRef("output-timeout"), true, true);
+
+  if (this->cancel_pending_) {
+    api::VoiceCallOutputCancel msg;
+    msg.call_id = this->call_id_;
+    msg.output_id = this->output_id_;
+    msg.reason = StringRef(this->output_reason_.data());
+    if (this->client_ != nullptr && !this->client_->send_message(msg))
+      return;
+    this->cancel_pending_ = false;
+  }
+  if (!this->output_cancelling_ && !this->finish_requested_ && this->renderer_owned_ && this->speaker_->is_running()) {
+    const size_t size = this->output_buffer_.contiguous_size();
+    if (size != 0) {
+      const size_t written = this->speaker_->play(this->output_buffer_.data(), size);
+      if (!this->output_buffer_.consume(written)) {
+        this->cancel_output_(StringRef("unaligned-speaker-write"), true, true);
+        return;
+      }
+    }
+    if (this->output_eof_ && this->output_buffer_.size() == 0) {
+      this->speaker_->finish();
+      this->finish_requested_ = true;
+    } else if (!this->output_eof_ && this->output_buffer_.max_frames() != this->granted_frames_) {
+      api::VoiceCallOutputStatus msg;
+      msg.call_id = this->call_id_;
+      msg.output_id = this->output_id_;
+      msg.state = api::enums::VOICE_CALL_OUTPUT_READY;
+      msg.max_frames = this->output_buffer_.max_frames();
+      if (this->client_ != nullptr && this->client_->send_message(msg))
+        this->granted_frames_ = msg.max_frames;
+    }
+  }
+  if (this->renderer_owned_ && !this->speaker_->call_output_stopped())
+    return;
+  if (!this->output_cancelling_) {
+    if (!this->finish_requested_ || this->rendered_frames_ != this->output_buffer_.received_frames()) {
+      this->cancel_output_(StringRef("incomplete-playback"), true, true);
+      return;
+    }
+    this->terminal_state_ = api::enums::VOICE_CALL_OUTPUT_PLAYED;
+  }
+  if (this->renderer_owned_) {
+    this->speaker_->end_call_output();
+    this->renderer_owned_ = false;
+  }
+  api::VoiceCallOutputStatus msg;
+  msg.call_id = this->call_id_;
+  msg.output_id = this->output_id_;
+  msg.state = this->terminal_state_;
+  msg.reason = StringRef(this->output_reason_.data());
+  if (this->client_ == nullptr || this->client_->send_message(msg))
+    this->terminal_sent_ = true;
+}
+
+void VoiceCall::stream_microphone_() {
+  // Bound work per loop so controls and speaker progress cannot starve.
+  for (size_t i = 0; i < 4; i++) {
+    size_t size;
+    {
+      LockGuard lock(this->microphone_mutex_);
+      size = std::min(this->microphone_buffer_.contiguous_size(), MAX_AUDIO_BYTES);
+      std::memcpy(this->microphone_send_buffer_.data(), this->microphone_buffer_.data(), size);
+    }
+    if (size == 0)
+      return;
+    api::VoiceCallAudio msg;
+    msg.call_id = this->call_id_;
+    msg.data = this->microphone_send_buffer_.data();
+    msg.data_len = size;
+    if (!this->client_->send_message(msg))
+      return;
+    this->microphone_progress_at_ = App.get_loop_component_start_time();
+    LockGuard lock(this->microphone_mutex_);
+    this->microphone_buffer_.consume(size);
+  }
+}
+
+void VoiceCall::loop() {
+  if (!this->is_running())
+    return;
+  bool overflow;
+  {
+    LockGuard lock(this->microphone_mutex_);
+    overflow = this->microphone_overflow_;
+    this->microphone_overflow_ = false;
+  }
+  if (overflow && this->state_ != CallState::CALL_STATE_STOPPING) {
+    this->stop_(StringRef("microphone-overflow"));
+    this->report_error_("microphone-overflow");
+  }
+  this->loop_output_();
+  if (this->state_ == CallState::CALL_STATE_STOPPING) {
+    if (this->renderer_owned_ || (this->output_present_ && !this->terminal_sent_))
+      return;
+    api::VoiceCallStop msg;
+    msg.call_id = this->call_id_;
+    msg.reason = StringRef(this->stop_reason_.data());
+    if (this->client_ != nullptr && !this->client_->send_message(msg))
+      return;
+    this->state_ = CallState::CALL_STATE_IDLE;
+    this->end_callback_.call();
+    return;
+  }
+  if (this->state_ == CallState::CALL_STATE_STARTING) {
+    if (App.get_loop_component_start_time() - this->started_at_ > START_TIMEOUT_MS) {
+      this->stop_(StringRef("start-timeout"));
+      this->report_error_("start-timeout");
+      return;
+    }
+    if (!this->start_sent_ && this->microphone_->is_running()) {
+      api::VoiceCallStartRequest msg;
+      msg.call_id = this->call_id_;
+      msg.wake_word = StringRef(this->wake_phrase_.data());
+      this->start_sent_ = this->client_->send_message(msg);
+    }
+  } else if (this->state_ == CallState::CALL_STATE_ACTIVE) {
+    this->stream_microphone_();
+    if (App.get_loop_component_start_time() - this->microphone_progress_at_ > START_TIMEOUT_MS) {
+      this->stop_(StringRef("microphone-stalled"));
+      this->report_error_("microphone-stalled");
+    }
+  }
+}
+
+}  // namespace esphome::voice_call
+#endif
diff --git a/esphome/components/voice_call/voice_call.h b/esphome/components/voice_call/voice_call.h
new file mode 100644
index 0000000000..d0709c2373
--- /dev/null
+++ b/esphome/components/voice_call/voice_call.h
@@ -0,0 +1,126 @@
+#pragma once
+
+#include "esphome/core/defines.h"
+#ifdef USE_VOICE_CALL
+
+#include "audio_buffer.h"
+#include "esphome/core/component.h"
+#include "esphome/core/helpers.h"
+#include "esphome/components/api/api_connection.h"
+#include "esphome/components/i2s_audio/speaker/i2s_audio_speaker_standard.h"
+#include "esphome/components/microphone/microphone_source.h"
+#ifdef USE_MICRO_WAKE_WORD
+#include "esphome/components/micro_wake_word/micro_wake_word.h"
+#endif
+
+namespace esphome::voice_call {
+
+static constexpr size_t MAX_AUDIO_BYTES = 1024;
+
+enum class CallState : uint8_t {
+  CALL_STATE_IDLE,
+  CALL_STATE_STARTING,
+  CALL_STATE_ACTIVE,
+  CALL_STATE_STOPPING,
+};
+
+class VoiceCall final : public Component {
+ public:
+  VoiceCall(microphone::MicrophoneSource *microphone, i2s_audio::I2SAudioSpeaker *speaker, uint32_t sample_rate,
+            uint8_t channels);
+  void setup() override;
+  void loop() override;
+  void dump_config() override;
+  float get_setup_priority() const override { return setup_priority::AFTER_CONNECTION; }
+  void on_shutdown() override;
+
+  void start();
+  void stop();
+  void cancel_output();
+  bool is_running() const { return this->state_ != CallState::CALL_STATE_IDLE; }
+  bool is_connected() const { return this->client_ != nullptr; }
+  api::APIConnection *get_api_connection() const { return this->client_; }
+  void subscribe(api::APIConnection *client, const api::VoiceCallSubscribeRequest &msg);
+  void disconnected(api::APIConnection *client);
+  void on_start_response(const api::VoiceCallStartResponse &msg);
+  void on_stop(const api::VoiceCallStop &msg);
+  void on_output_start(const api::VoiceCallOutputStart &msg);
+  void on_output_audio(const api::VoiceCallOutputAudio &msg);
+  void on_output_end(const api::VoiceCallOutputEnd &msg);
+  void on_output_cancel(const api::VoiceCallOutputCancel &msg);
+  void on_feedback(const api::VoiceCallFeedback &msg);
+  void get_capabilities(api::VoiceCallCapabilities &capabilities) const;
+
+#ifdef USE_MICRO_WAKE_WORD
+  void set_micro_wake_word(micro_wake_word::MicroWakeWord *wake_word) { this->wake_word_ = wake_word; }
+#endif
+  void set_stop_wake_word(const char *phrase) { this->stop_wake_word_ = StringRef(phrase); }
+  template<typename F> void add_on_start_callback(F &&callback) {
+    this->start_callback_.add(std::forward<F>(callback));
+  }
+  template<typename F> void add_on_end_callback(F &&callback) { this->end_callback_.add(std::forward<F>(callback)); }
+  template<typename F> void add_on_feedback_callback(F &&callback) {
+    this->feedback_callback_.add(std::forward<F>(callback));
+  }
+  template<typename F> void add_on_error_callback(F &&callback) {
+    this->error_callback_.add(std::forward<F>(callback));
+  }
+
+ protected:
+  void request_start_(StringRef wake_word);
+  void stop_(StringRef reason);
+  void cancel_output_(StringRef reason, bool notify, bool error = false);
+  void loop_output_();
+  void stream_microphone_();
+  void stop_microphone_();
+  bool matches_(uint64_t call_id) const;
+  bool matches_output_(uint64_t call_id, uint64_t output_id) const;
+  void report_error_(const char *reason);
+
+  microphone::MicrophoneSource *microphone_;
+  i2s_audio::I2SAudioSpeaker *speaker_;
+  audio::AudioStreamInfo output_format_;
+  api::APIConnection *client_{nullptr};
+#ifdef USE_MICRO_WAKE_WORD
+  micro_wake_word::MicroWakeWord *wake_word_{nullptr};
+#endif
+  StringRef stop_wake_word_;
+  CallState state_{CallState::CALL_STATE_IDLE};
+  uint64_t call_id_{0};
+  uint64_t output_id_{0};
+  bool output_present_{false};
+  uint32_t started_at_{0};
+  uint32_t microphone_progress_at_{0};
+  uint32_t output_progress_at_{0};
+  uint32_t last_rendered_{0};
+  uint64_t rendered_frames_{0};
+  uint64_t granted_frames_{0};
+  bool start_sent_{false};
+  bool output_eof_{false};
+  bool output_cancelling_{false};
+  bool cancel_pending_{false};
+  bool finish_requested_{false};
+  bool renderer_owned_{false};
+  bool terminal_sent_{false};
+  api::enums::VoiceCallOutputState terminal_state_{api::enums::VOICE_CALL_OUTPUT_UNKNOWN};
+  std::array<char, 96> wake_phrase_{};
+  std::array<char, 96> stop_reason_{};
+  std::array<char, 96> output_reason_{};
+  AudioBuffer<8192> output_buffer_;
+
+  Mutex microphone_mutex_;
+  AudioBuffer<16384> microphone_buffer_;
+  std::array<uint8_t, MAX_AUDIO_BYTES> microphone_send_buffer_{};
+  bool capture_enabled_{false};      // Protected by microphone_mutex_.
+  bool microphone_overflow_{false};  // Protected by microphone_mutex_.
+
+  LazyCallbackManager<void()> start_callback_;
+  LazyCallbackManager<void()> end_callback_;
+  LazyCallbackManager<void(bool, bool)> feedback_callback_;
+  LazyCallbackManager<void(const char *)> error_callback_;
+};
+
+extern VoiceCall *global_voice_call;
+
+}  // namespace esphome::voice_call
+#endif
