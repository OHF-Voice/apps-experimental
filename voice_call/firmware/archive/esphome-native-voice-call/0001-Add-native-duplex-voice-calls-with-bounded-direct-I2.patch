diff --git a/tests/unit_tests/components/voice_call/fixtures/native_test.cpp b/tests/unit_tests/components/voice_call/fixtures/native_test.cpp
new file mode 100644
index 0000000000..bab549958a
--- /dev/null
+++ b/tests/unit_tests/components/voice_call/fixtures/native_test.cpp
@@ -0,0 +1,235 @@
+#include "esphome/components/voice_call/voice_call.h"
+
+using namespace esphome;
+using namespace esphome::api;
+using namespace esphome::api::enums;
+
+struct Fixture {
+  microphone::MicrophoneSource mic;
+  i2s_audio::I2SAudioSpeaker speaker;
+  micro_wake_word::MicroWakeWord wake;
+  APIConnection client;
+  voice_call::VoiceCall call{&mic, &speaker, 48000, 2};
+  uint64_t cookie{};
+  Fixture() {
+    App.now = 100;
+    call.set_micro_wake_word(&wake);
+    call.set_stop_wake_word("Stop");
+    call.setup();
+    call.subscribe(&client, {true, 1});
+  }
+  void start() {
+    call.start();
+    call.loop();
+    cookie = client.sent<VoiceCallStartRequest>().back().call_id;
+    call.on_start_response({cookie, true, {}});
+  }
+  void output(uint64_t id = 0) {
+    call.on_output_start({cookie, id, 48000, 2, 2});
+    call.loop();
+    speaker.complete_start();
+    call.loop();
+    assert(client.sent<VoiceCallOutputStatus>().back().state == VOICE_CALL_OUTPUT_READY);
+  }
+  bool has_terminal() const {
+    for (const auto &msg : client.sent<VoiceCallOutputStatus>())
+      if (msg.state != VOICE_CALL_OUTPUT_READY)
+        return true;
+    return false;
+  }
+};
+
+static void buffer_contract() {
+  voice_call::AudioBuffer<16> buffer;
+  buffer.reset(4);
+  const uint8_t data[]{0, 1, 2, 3, 4, 5, 6, 7};
+  assert(buffer.max_frames() == 4);
+  assert(!buffer.append(data, 3));
+  assert(buffer.append(data, 8));
+  assert(buffer.append(data, 8));
+  assert(!buffer.append(data, 4));
+  assert(buffer.received_frames() == 4);
+  assert(buffer.consume(4));
+  assert(buffer.max_frames() == 5);
+  assert(!buffer.consume(3));
+  assert(buffer.append(data, 4));
+  assert(buffer.contiguous_size() == 12);
+  assert(buffer.consume(12));
+  assert(buffer.contiguous_size() == 4);
+  assert(std::memcmp(buffer.data(), data, 4) == 0);
+}
+
+static void first_output_zero_and_true_eof() {
+  Fixture f;
+  f.start();
+  assert(f.cookie != 0);
+  f.output();
+  auto status = f.client.sent<VoiceCallOutputStatus>().back();
+  assert(status.output_id == 0 && status.max_frames == 2048);
+  uint8_t pcm[]{1, 2, 3, 4};
+  f.call.on_output_audio({f.cookie, 0, pcm, 4});
+  pcm[0] = 99;  // Receive storage is borrowed; the component must already own a copy.
+  f.call.loop();
+  assert(f.speaker.accepted_audio[0] == 1);
+  assert(f.client.sent<VoiceCallOutputStatus>().back().max_frames == 2049);
+  f.call.on_output_end({f.cookie, 0});
+  f.call.loop();
+  assert(f.speaker.finishing);
+  assert(!f.has_terminal());
+  f.speaker.complete_finish();
+  f.call.loop();
+  assert(f.client.sent<VoiceCallOutputStatus>().back().state == VOICE_CALL_OUTPUT_PLAYED);
+  assert(f.mic.running && f.call.is_running());
+  f.output(1);
+}
+
+static void cancel_is_local_and_flush_is_not_stop_request() {
+  Fixture f;
+  f.start();
+  f.output();
+  f.client.blocked = true;
+  f.wake.detect("Stop");
+  assert(f.speaker.stop_requested);
+  f.call.loop();
+  assert(!f.has_terminal());
+  assert(f.mic.running);
+  uint8_t pcm[]{1, 2, 3, 4};
+  f.call.on_output_audio({f.cookie, 0, pcm, 4});
+  f.client.blocked = false;
+  f.call.loop();
+  assert(f.client.sent<VoiceCallOutputCancel>().back().output_id == 0);
+  assert(f.client.sent<VoiceCallOutputCancel>().back().reason == "stop-wake-word");
+  assert(!f.has_terminal());
+  f.speaker.complete_stop();
+  f.call.loop();
+  assert(f.client.sent<VoiceCallOutputStatus>().back().state == VOICE_CALL_OUTPUT_STOPPED);
+  assert(f.speaker.accepted_audio.empty());
+  f.mic.receive(128);
+  f.call.loop();
+  assert(!f.client.microphone_audio.empty());
+  f.call.on_output_end({f.cookie, 0});
+  f.output(1);
+}
+
+static void errors_never_report_played() {
+  Fixture f;
+  f.start();
+  f.output();
+  f.speaker.failed = true;  // DMA resynchronization/discard is an error even if a legacy callback reports progress.
+  f.speaker.rendered = 100;
+  f.call.on_output_end({f.cookie, 0});
+  f.call.loop();
+  assert(!f.has_terminal());
+  f.speaker.complete_stop();
+  f.call.loop();
+  assert(f.client.sent<VoiceCallOutputStatus>().back().state == VOICE_CALL_OUTPUT_ERROR);
+  assert(f.mic.running);
+}
+
+static void microphone_bootstrap_retry_overflow_and_generations() {
+  Fixture f;
+  f.call.start();
+  f.mic.receive(1024, 42);
+  f.call.loop();
+  f.cookie = f.client.sent<VoiceCallStartRequest>().back().call_id;
+  assert(f.client.microphone_audio.empty());
+  f.call.on_start_response({f.cookie, true, {}});
+  f.client.blocked = true;
+  f.call.loop();
+  assert(f.client.microphone_audio.empty());
+  f.client.blocked = false;
+  f.call.loop();
+  assert(f.client.microphone_audio.size() == 1 && f.client.microphone_audio[0][0] == 42);
+  f.output();
+  f.call.disconnected(&f.client);
+  assert(!f.mic.running);
+  f.call.loop();
+  assert(f.call.is_running());  // Flush has not completed.
+  f.speaker.complete_stop();
+  f.call.loop();
+  assert(!f.call.is_running());
+  f.call.subscribe(&f.client, {true, 1});
+  const auto old_cookie = f.cookie;
+  f.start();
+  assert(f.cookie > old_cookie);
+  f.call.on_stop({old_cookie, StringRef("stale")});
+  f.call.on_output_start({old_cookie, 0, 48000, 2, 2});
+  assert(f.mic.running);
+  f.mic.receive(16384);
+  f.mic.receive(2);
+  f.call.loop();
+  assert(!f.mic.running && !f.call.is_running());
+  assert(f.client.sent<VoiceCallStop>().back().reason == "microphone-overflow");
+}
+
+static void empty_output_and_credit_violation() {
+  Fixture f;
+  f.start();
+  f.output();
+  f.call.on_output_end({f.cookie, 0});
+  f.call.loop();
+  f.speaker.complete_finish();
+  f.call.loop();
+  assert(f.client.sent<VoiceCallOutputStatus>().back().state == VOICE_CALL_OUTPUT_PLAYED);
+  f.output(1);
+  f.speaker.max_accept = 0;
+  std::array<uint8_t, 1024> pcm{};
+  for (unsigned i = 0; i < 8; i++)
+    f.call.on_output_audio({f.cookie, 1, pcm.data(), 1024});
+  f.call.loop();
+  assert(f.client.sent<VoiceCallOutputStatus>().back().max_frames == 2048);
+  f.call.on_output_audio({f.cookie, 1, pcm.data(), 4});
+  assert(f.speaker.stop_requested);
+  f.speaker.complete_stop();
+  f.call.loop();
+  assert(f.client.sent<VoiceCallOutputStatus>().back().state == VOICE_CALL_OUTPUT_ERROR);
+}
+
+static void call_stop_waits_for_hardware_and_network() {
+  Fixture f;
+  f.start();
+  f.output();
+  f.call.on_stop({f.cookie, StringRef("remote-stop")});
+  f.call.loop();
+  assert(!f.mic.running && f.client.sent<VoiceCallStop>().empty());
+  f.speaker.complete_stop();
+  f.client.blocked = true;
+  f.call.loop();
+  assert(f.call.is_running());
+  f.client.blocked = false;
+  f.call.loop();
+  assert(!f.call.is_running());
+  assert(f.client.sent<VoiceCallStop>().size() == 1);
+}
+
+static void feedback_and_wake_hooks() {
+  Fixture f;
+  int starts = 0;
+  bool listening = false, processing = false;
+  f.call.add_on_start_callback([&]() { starts++; });
+  f.call.add_on_feedback_callback([&](bool l, bool p) {
+    listening = l;
+    processing = p;
+  });
+  f.wake.detect("Okay Nabu");
+  f.call.loop();
+  const auto request = f.client.sent<VoiceCallStartRequest>().back();
+  assert(request.wake_word == "Okay Nabu");
+  f.call.on_start_response({request.call_id, true, {}});
+  assert(starts == 1);
+  f.call.on_feedback({request.call_id, true, true});
+  assert(listening && processing && f.mic.running);
+  f.call.on_feedback({request.call_id + 1, false, false});
+  assert(listening && processing);
+}
+
+int main() {
+  buffer_contract();
+  first_output_zero_and_true_eof();
+  cancel_is_local_and_flush_is_not_stop_request();
+  errors_never_report_played();
+  microphone_bootstrap_retry_overflow_and_generations();
+  empty_output_and_credit_violation();
+  call_stop_waits_for_hardware_and_network();
+  feedback_and_wake_hooks();
+}
