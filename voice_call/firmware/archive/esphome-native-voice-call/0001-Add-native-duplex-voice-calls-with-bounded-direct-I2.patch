-// ==================== VOICE ASSISTANT ====================
+// ==================== VOICE CALL ====================
+// IDs 153-155 are reserved by the client schema. Calls never reuse legacy
+// VoiceAssistantAudio: call_id identifies an activation on a long-lived connection.
+message VoiceCallSubscribeRequest {
+  option (id) = 156;
+  option (source) = SOURCE_CLIENT;
+  option (ifdef) = "USE_VOICE_CALL";
+  bool subscribe = 1;
+  uint32 version = 2;
+}
+
+message VoiceCallStartRequest {
+  option (id) = 157;
+  option (source) = SOURCE_SERVER;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  string wake_word = 2;
+}
+
+message VoiceCallStartResponse {
+  option (id) = 158;
+  option (source) = SOURCE_CLIENT;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  bool accepted = 2;
+  string reason = 3;
+}
+
+message VoiceCallAudio {
+  option (id) = 159;
+  option (source) = SOURCE_SERVER;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  bytes data = 2 [(pointer_to_buffer) = true];  // 16 kHz, signed 16-bit LE mono, at most 1024 bytes.
+}
+
+// Client requests stop; server confirms local teardown. Do not echo a server stop.
+message VoiceCallStop {
+  option (id) = 160;
+  option (source) = SOURCE_BOTH;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  string reason = 2;
+}
+
+message VoiceCallOutputStart {
+  option (id) = 161;
+  option (source) = SOURCE_CLIENT;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  uint64 output_id = 2;
+  uint32 sample_rate = 3;
+  uint32 channels = 4;
+  uint32 width = 5;
+}
+
+message VoiceCallOutputAudio {
+  option (id) = 162;
+  option (source) = SOURCE_CLIENT;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  uint64 output_id = 2;
+  bytes data = 3;  // Whole source frames, at most the advertised max_audio_bytes.
+}
+
+// EOF, not playback completion. Required even after cancellation.
+message VoiceCallOutputEnd {
+  option (id) = 163;
+  option (source) = SOURCE_CLIENT;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  uint64 output_id = 2;
+}
+
+message VoiceCallOutputCancel {
+  option (id) = 164;
+  option (source) = SOURCE_BOTH;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  uint64 output_id = 2;
+  string reason = 3;
+}
+
+enum VoiceCallOutputState {
+  VOICE_CALL_OUTPUT_UNKNOWN = 0;
+  VOICE_CALL_OUTPUT_READY = 1;
+  VOICE_CALL_OUTPUT_PLAYED = 2;
+  VOICE_CALL_OUTPUT_STOPPED = 3;
+  VOICE_CALL_OUTPUT_ERROR = 4;
+}
+
+message VoiceCallOutputStatus {
+  option (id) = 165;
+  option (source) = SOURCE_SERVER;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  uint64 output_id = 2;
+  VoiceCallOutputState state = 3;
+  // READY grants an absolute cumulative limit in source frames, not rendered frames.
+  uint64 max_frames = 4;
+  string reason = 5;
+}
+
+message VoiceCallFeedback {
+  option (id) = 166;
+  option (source) = SOURCE_CLIENT;
+  option (ifdef) = "USE_VOICE_CALL";
+  uint64 call_id = 1;
+  bool listening = 2;
+  bool processing = 3;
+}
+
+// ==================== LEGACY VOICE ASSISTANT ====================
 enum VoiceAssistantSubscribeFlag {
   VOICE_ASSISTANT_SUBSCRIBE_NONE = 0;
   VOICE_ASSISTANT_SUBSCRIBE_API_AUDIO = 1;
