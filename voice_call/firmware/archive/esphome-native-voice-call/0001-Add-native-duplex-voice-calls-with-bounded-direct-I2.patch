+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <variant>
+#include <vector>
+
+#include "esphome/core/string_ref.h"
+
+namespace esphome {
+using Mutex = std::mutex;
+using LockGuard = std::lock_guard<Mutex>;
+template<typename F> class LazyCallbackManager {
+ public:
+  template<typename C> void add(C callback) { callbacks.push_back(callback); }
+  template<typename... T> void call(T... args) {
+    for (auto &callback : callbacks)
+      callback(args...);
+  }
+  std::vector<std::function<F>> callbacks;
+};
+namespace setup_priority {
+inline constexpr float AFTER_CONNECTION = 100;
+}
+class Component {
+ public:
+  virtual void setup() {}
+  virtual void loop() {}
+  virtual void dump_config() {}
+  virtual void on_shutdown() {}
+  virtual float get_setup_priority() const { return 0; }
+  bool is_failed() const { return false; }
+};
+struct Application {
+  uint32_t now{100};
+  uint32_t get_loop_component_start_time() const { return now; }
+};
+inline Application App;
+namespace audio {
+struct AudioStreamInfo {
+  AudioStreamInfo(uint8_t bits, uint8_t channels, uint32_t rate) : channels(channels), rate(rate) {}
+  uint32_t get_sample_rate() const { return rate; }
+  uint8_t get_channels() const { return channels; }
+  size_t frames_to_bytes(size_t frames) const { return frames * channels * 2; }
+  uint8_t channels;
+  uint32_t rate;
+};
+}  // namespace audio
+namespace api {
+namespace enums {
+enum VoiceCallOutputState {
+  VOICE_CALL_OUTPUT_UNKNOWN,
+  VOICE_CALL_OUTPUT_READY,
+  VOICE_CALL_OUTPUT_PLAYED,
+  VOICE_CALL_OUTPUT_STOPPED,
+  VOICE_CALL_OUTPUT_ERROR,
+};
+}
+struct VoiceCallAudioFormat {
+  uint32_t sample_rate{}, channels{}, width{};
+};
+struct VoiceCallCapabilities {
+  uint32_t feature_flags{}, version{}, max_audio_bytes{};
+  std::array<VoiceCallAudioFormat, 1> output_formats{};
+};
+struct VoiceCallSubscribeRequest {
+  bool subscribe{};
+  uint32_t version{};
+};
+struct VoiceCallStartRequest {
+  uint64_t call_id{};
+  StringRef wake_word;
+};
+struct VoiceCallStartResponse {
+  uint64_t call_id{};
+  bool accepted{};
+  StringRef reason;
+};
+struct VoiceCallStop {
+  uint64_t call_id{};
+  StringRef reason;
+};
+struct VoiceCallAudio {
+  uint64_t call_id{};
+  const uint8_t *data{};
+  uint16_t data_len{};
+};
+struct VoiceCallOutputStart {
+  uint64_t call_id{}, output_id{};
+  uint32_t sample_rate{}, channels{}, width{};
+};
+struct VoiceCallOutputAudio {
+  uint64_t call_id{}, output_id{};
+  const uint8_t *data{};
+  uint16_t data_len{};
+};
+struct VoiceCallOutputEnd {
+  uint64_t call_id{}, output_id{};
+};
+struct VoiceCallOutputCancel {
+  uint64_t call_id{}, output_id{};
+  StringRef reason;
+};
+struct VoiceCallOutputStatus {
+  uint64_t call_id{}, output_id{};
+  enums::VoiceCallOutputState state{};
+  uint64_t max_frames{};
+  StringRef reason;
+};
+struct VoiceCallFeedback {
+  uint64_t call_id{};
+  bool listening{}, processing{};
+};
+using Message =
+    std::variant<VoiceCallStartRequest, VoiceCallStop, VoiceCallAudio, VoiceCallOutputCancel, VoiceCallOutputStatus>;
+class APIConnection {
+ public:
+  bool blocked{false};
+  std::vector<Message> messages;
+  std::vector<std::vector<uint8_t>> microphone_audio;
+  template<typename T> bool send_message(const T &msg) {
+    if (blocked)
+      return false;
+    messages.emplace_back(msg);
+    if constexpr (std::is_same_v<T, VoiceCallAudio>)
+      microphone_audio.emplace_back(msg.data, msg.data + msg.data_len);
+    return true;
+  }
+  template<typename T> std::vector<T> sent() const {
+    std::vector<T> result;
+    for (const auto &msg : messages)
+      if (const auto *value = std::get_if<T>(&msg))
+        result.push_back(*value);
+    return result;
+  }
+};
+}  // namespace api
+namespace microphone {
+class MicrophoneSource {
+ public:
+  bool running{false};
+  bool muted{false};
+  std::function<void(const std::vector<uint8_t> &)> callback;
+  template<typename F> void add_data_callback(F cb) { callback = cb; }
+  void start() { running = true; }
+  void stop() { running = false; }
+  bool is_running() const { return running; }
+  bool get_mute_state() const { return muted; }
+  void receive(size_t size, uint8_t value = 1) {
+    if (running)
+      callback(std::vector<uint8_t>(size, value));
+  }
+};
+}  // namespace microphone
+namespace i2s_audio {
+class I2SAudioSpeaker {
+ public:
+  bool running{false}, stopped{true}, finishing{false}, failed{false}, stop_requested{false};
+  uint32_t rendered{0};
+  uint64_t accepted_frames{0};
+  size_t max_accept{1024};
+  uint8_t channels{2};
+  std::vector<uint8_t> accepted_audio;
+  bool begin_call_output() {
+    if (!stopped)
+      return false;
+    rendered = 0;
+    accepted_frames = 0;
+    accepted_audio.clear();
+    failed = false;
+    finishing = false;
+    stop_requested = false;
+    return true;
+  }
+  bool call_output_stopped() const { return stopped; }
+  uint32_t get_call_frames_played() const { return rendered; }
+  bool call_output_failed() const { return failed; }
+  void end_call_output() {}
+  void set_audio_stream_info(audio::AudioStreamInfo info) { channels = info.channels; }
+  void start() { stopped = false; }
+  void complete_start() { running = true; }
+  bool is_running() const { return running; }
+  size_t play(const uint8_t *data, size_t size) {
+    size = std::min(size, max_accept);
+    accepted_frames += size / (channels * 2);
+    accepted_audio.insert(accepted_audio.end(), data, data + size);
+    return size;
+  }
+  void finish() { finishing = true; }
+  void stop() {
+    stop_requested = true;
+    stopped = false;
+    running = false;
+  }
+  void complete_stop() {
+    running = false;
+    stopped = true;
+  }
+  void complete_finish() {
+    assert(finishing);
+    rendered = accepted_frames;
+    complete_stop();
+  }
+};
+}  // namespace i2s_audio
+namespace micro_wake_word {
+class MicroWakeWord {
+ public:
+  std::function<void(const std::string &)> callback;
+  template<typename F> void add_wake_word_detected_callback(F cb) { callback = cb; }
+  void start() {}
+  void detect(const std::string &phrase) { callback(phrase); }
+};
+}  // namespace micro_wake_word
+}  // namespace esphome
