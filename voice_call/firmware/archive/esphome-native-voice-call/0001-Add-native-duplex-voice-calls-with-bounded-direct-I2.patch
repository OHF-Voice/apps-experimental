+"""Run the real call controller against deterministic microphone, API and DMA fakes."""
+
+from pathlib import Path
+import subprocess
+
+import esphome
+
+
+def test_native_call_controller(tmp_path: Path) -> None:
+    fixtures = Path(__file__).parent / "fixtures"
+    root = Path(esphome.__file__).parent.parent
+    includes = (
+        "core/defines.h",
+        "core/component.h",
+        "core/helpers.h",
+        "core/application.h",
+        "core/log.h",
+        "components/api/api_connection.h",
+        "components/i2s_audio/speaker/i2s_audio_speaker_standard.h",
+        "components/microphone/microphone_source.h",
+        "components/micro_wake_word/micro_wake_word.h",
+    )
+    for name in includes:
+        header = tmp_path / "esphome" / name
+        header.parent.mkdir(parents=True, exist_ok=True)
+        header.write_text('#include "native_test.h"\n', encoding="utf-8")
+    (tmp_path / "esphome/core/log.h").write_text(
+        "#define ESP_LOGE(...) ((void) 0)\n"
+        "#define ESP_LOGW(...) ((void) 0)\n"
+        "#define ESP_LOGCONFIG(...) ((void) 0)\n",
+        encoding="utf-8",
+    )
+    executable = tmp_path / "voice_call_test"
+    subprocess.run(
+        [
+            "g++",
+            "-std=c++20",
+            "-Wall",
+            "-Wextra",
+            "-Werror",
+            "-Wno-unused-parameter",
+            "-Wno-unused-variable",
+            "-DUSE_VOICE_CALL",
+            "-DUSE_MICRO_WAKE_WORD",
+            f"-I{tmp_path}",
+            f"-I{fixtures}",
+            f"-I{root}",
+            str(root / "esphome/components/voice_call/voice_call.cpp"),
+            str(fixtures / "native_test.cpp"),
+            "-o",
+            str(executable),
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    subprocess.run([str(executable)], check=True, capture_output=True, text=True)
