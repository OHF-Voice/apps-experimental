#!/usr/bin/env bash
# Copy what the image needs but git does not carry into local/, for the
# Dockerfile: the English models the app doesn't download (speaker ID, the
# wake words, the Kaldi verifier's model and tools),
# wyoming-wake-kaldi, which is not published, and microWakeWord's working
# tree. Parakeet, EmbeddingGemma and GLiNER are downloaded when the app first
# starts (voice_labs/downloads.py), and Piper's voices when one is first used
# (voice_labs/piper_voices.py); other languages, the multilingual model
# and the wake word training kit aren't in the image. The Kaldi tools and its
# daemon are native binaries: stage them on (or for) the architecture you
# build for.
#
#   script/stage_build [--arch aarch64]
#
# --arch: the architecture the image is for (default this machine's).
set -euo pipefail
cd "$(dirname "$0")/.."
KALDI_SRC="${WYOMING_WAKE_KALDI:-$HOME/opt/wyoming-wake-kaldi}"
arch="$(uname -m)"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --arch) arch="$2"; shift ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done

rm -rf local
mkdir -p local/models
cp -a models/speaker models/wake models/wake-kaldi-models local/models/
# The Kaldi verifier's tools and its resident decoder. x86-64's as built here;
# aarch64's the Kaldi of 2021 (scripts/make_kaldi_tools_aarch64.sh), with the
# decoder's source, which the image's build compiles.
if [[ "$arch" == aarch64 ]]; then
    cp -a models/wake-kaldi-tools-aarch64 local/models/wake-kaldi-tools
    mkdir -p local/models/wake-kaldi-decoderd
    cp models/wake-kaldi-decoderd/build.sh models/wake-kaldi-decoderd/verify_decoderd.cc local/models/wake-kaldi-decoderd/
else
    cp -a models/wake-kaldi-tools models/wake-kaldi-decoderd local/models/
fi

mkdir -p local/wyoming-wake-kaldi
cp -a "$KALDI_SRC/pyproject.toml" "$KALDI_SRC/wyoming_wake_kaldi" local/wyoming-wake-kaldi/
# sentence-stream 1.4.0, until it is released: its markdown fixes ("**Lift:**"
# was left with its asterisks, which Piper reads out).
SENTENCE_SRC="${SENTENCE_STREAM:-$HOME/opt/sentence-stream}"
mkdir -p local/sentence-stream
cp -a "$SENTENCE_SRC/pyproject.toml" "$SENTENCE_SRC/setup.cfg" "$SENTENCE_SRC/README.md" "$SENTENCE_SRC/LICENSE.md" \
      "$SENTENCE_SRC/sentence_stream" local/sentence-stream/
# microWakeWord, to train wake words in the app (installed without its
# dependencies: requirements-training.txt has what training needs). From its
# working tree, which keeps its audio stack, TensorBoard and evaluation out of
# a training run (micro-wake-word's notebooks/ON_DEVICE_WARM_START.md).
MWW_SRC="${MICRO_WAKE_WORD:-$HOME/opt/micro-wake-word}"
mkdir -p local/micro-wake-word
cp -a "$MWW_SRC/setup.py" "$MWW_SRC/README.md" "$MWW_SRC/microwakeword" local/micro-wake-word/
find local -name __pycache__ -prune -exec rm -rf {} +
du -sh local/models local/wyoming-wake-kaldi local/micro-wake-word local/sentence-stream
