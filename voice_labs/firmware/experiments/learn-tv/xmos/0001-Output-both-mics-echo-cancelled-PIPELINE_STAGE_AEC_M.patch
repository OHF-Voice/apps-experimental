From 7ffef53145b9166d5cb95a366e46edba5f7fd673 Mon Sep 17 00:00:00 2001
From: Michael Hansen <mike@rhasspy.org>
Date: Wed, 21 Oct 2026 11:45:35 -0500
Subject: [PATCH] Output both mics echo cancelled: PIPELINE_STAGE_AEC_MIC0

The AEC stage cancels echo on both mics, but the IC overwrites mic 0's result
in place, so only mic 1's (PIPELINE_STAGE_AEC) could leave the device. Save mic
0's before the IC runs (fixed_delay pipeline) as a 7th output channel, selected
on either I2S channel by the new stage value 5. Existing stages are unchanged.
Version 1.3.101, so ESPHome's voice_kit installs it over a stock 1.3.1.

-DFFVA_L71_FLASH=ON also accepts the XK-VOICE-L71's W25Q64JW flash, so this
firmware can be smoke-tested on the L71 dev board (it boots and runs).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../fixed_delay/audio_pipeline_dsp.h          |  3 ++
 .../reference/fixed_delay/audio_pipeline_t0.c |  3 +-
 .../NC-VOICE-KIT/NC-VOICE-KIT.cmake           |  7 ++++
 .../NC-VOICE-KIT/platform/platform_init.c     | 42 +++++++++++++++++--
 src/ffva/src/app_conf.h                       |  4 +-
 .../configuration/configuration_servicer.h    |  1 +
 src/ffva/src/main.c                           |  7 ++++
 7 files changed, 62 insertions(+), 5 deletions(-)

diff --git a/modules/audio_pipelines/reference/fixed_delay/audio_pipeline_dsp.h b/modules/audio_pipelines/reference/fixed_delay/audio_pipeline_dsp.h
index 8c37f01..e16ebbd 100644
--- a/modules/audio_pipelines/reference/fixed_delay/audio_pipeline_dsp.h
+++ b/modules/audio_pipelines/reference/fixed_delay/audio_pipeline_dsp.h
@@ -42,6 +42,9 @@ typedef struct {
     int32_t samples[appconfAUDIO_PIPELINE_CHANNELS][appconfAUDIO_PIPELINE_FRAME_ADVANCE];
     int32_t aec_reference_audio_samples[appconfAUDIO_PIPELINE_CHANNELS][appconfAUDIO_PIPELINE_FRAME_ADVANCE];
     int32_t mic_samples_passthrough[appconfAUDIO_PIPELINE_CHANNELS][appconfAUDIO_PIPELINE_FRAME_ADVANCE];
+    /* Mic 0 after AEC, saved before the IC overwrites it: the output's 7th channel
+     * (PIPELINE_STAGE_AEC_MIC0), so that both mics leave the device echo cancelled. */
+    int32_t aec_mic0_samples[appconfAUDIO_PIPELINE_FRAME_ADVANCE];
 
     /* Below is additional context needed by other stages on a per frame basis */
     int32_t vnr_pred_flag;
diff --git a/modules/audio_pipelines/reference/fixed_delay/audio_pipeline_t0.c b/modules/audio_pipelines/reference/fixed_delay/audio_pipeline_t0.c
index a162c13..8e289f9 100644
--- a/modules/audio_pipelines/reference/fixed_delay/audio_pipeline_t0.c
+++ b/modules/audio_pipelines/reference/fixed_delay/audio_pipeline_t0.c
@@ -70,12 +70,13 @@ static int audio_pipeline_output_i(frame_data_t *frame_data,
 {
     return audio_pipeline_output(output_app_data,
                                (int32_t **)frame_data->samples,
-                               6,
+                               7,
                                appconfAUDIO_PIPELINE_FRAME_ADVANCE);
 }
 
 static void stage_vnr_and_ic(frame_data_t *frame_data)
 {
+    memcpy(frame_data->aec_mic0_samples, frame_data->samples[0], appconfAUDIO_PIPELINE_FRAME_ADVANCE * sizeof(int32_t));
 #if appconfAUDIO_PIPELINE_SKIP_IC_AND_VAD
 #else
     int32_t DWORD_ALIGNED ic_output[appconfAUDIO_PIPELINE_FRAME_ADVANCE];
diff --git a/src/ffva/bsp_config/NC-VOICE-KIT/NC-VOICE-KIT.cmake b/src/ffva/bsp_config/NC-VOICE-KIT/NC-VOICE-KIT.cmake
index 68a4841..a6b9e4b 100644
--- a/src/ffva/bsp_config/NC-VOICE-KIT/NC-VOICE-KIT.cmake
+++ b/src/ffva/bsp_config/NC-VOICE-KIT/NC-VOICE-KIT.cmake
@@ -29,6 +29,13 @@ target_link_options(sln_voice_app_ffva_board_support_nc_voice_kit
     INTERFACE
         ${CMAKE_CURRENT_LIST_DIR}/NC-VOICE-KIT.xn
 )
+# -DFFVA_L71_FLASH=ON: also accept an XK-VOICE-L71's flash, to smoke-test this
+# firmware on the L71 dev board (see platform_init.c).
+option(FFVA_L71_FLASH "Accept the XK-VOICE-L71's W25Q64JW flash too" OFF)
+if(FFVA_L71_FLASH)
+    target_compile_definitions(sln_voice_app_ffva_board_support_nc_voice_kit INTERFACE FFVA_L71_FLASH=1)
+endif()
+
 target_compile_definitions(sln_voice_app_ffva_board_support_nc_voice_kit
     INTERFACE
         XK_VOICE_L71=1
diff --git a/src/ffva/bsp_config/NC-VOICE-KIT/platform/platform_init.c b/src/ffva/bsp_config/NC-VOICE-KIT/platform/platform_init.c
index 6f07a33..3014cdb 100644
--- a/src/ffva/bsp_config/NC-VOICE-KIT/platform/platform_init.c
+++ b/src/ffva/bsp_config/NC-VOICE-KIT/platform/platform_init.c
@@ -43,10 +43,46 @@ static void mclk_init(chanend_t other_tile_c)
 #endif
 }
 
+#if FFVA_L71_FLASH
+/* Smoke tests on an XK-VOICE-L71, whose 8 MB flash (W25Q64JW) the VPE's two
+ * parts don't cover. From sln_voice's XK_VOICE_L71 platform_conf.h. */
+#define FL_QUADDEVICE_W25Q64JW \
+{ \
+    0,                      /* Just specify 0 as flash_id */ \
+    256,                    /* page size */ \
+    32768,                  /* num pages */ \
+    3,                      /* address size */ \
+    4,                      /* log2 clock divider */ \
+    0x9F,                   /* QSPI_RDID */ \
+    0,                      /* id dummy bytes */ \
+    3,                      /* id size in bytes */ \
+    0xEF6017,               /* device id (determined from xflash --spi-read-id 0x9F)*/ \
+    0x20,                   /* QSPI_SE */ \
+    4096,                   /* Sector erase is always 4KB */ \
+    0x06,                   /* QSPI_WREN */ \
+    0x04,                   /* QSPI_WRDI */ \
+    PROT_TYPE_SR,           /* Protection via SR */ \
+    {{0x18,0x00},{0,0}},    /* QSPI_SP, QSPI_SU */ \
+    0x02,                   /* QSPI_PP */ \
+    0xEB,                   /* QSPI_READ_FAST */ \
+    1,                      /* 1 read dummy byte */ \
+    SECTOR_LAYOUT_REGULAR,  /* mad sectors */ \
+    {4096,{0,{0}}},         /* regular sector sizes */ \
+    0x05,                   /* QSPI_RDSR */ \
+    0x01,                   /* QSPI_WRSR */ \
+    0x01,                   /* QSPI_WIP_BIT_MASK */ \
+}
+#define FFVA_QSPI_SPECS {FL_QUADDEVICE_W25Q32JV, FL_QUADDEVICE_ZB25VQ32D, FL_QUADDEVICE_W25Q64JW}
+#define FFVA_QSPI_SPEC_COUNT 3
+#else
+#define FFVA_QSPI_SPECS {FL_QUADDEVICE_W25Q32JV, FL_QUADDEVICE_ZB25VQ32D}
+#define FFVA_QSPI_SPEC_COUNT 2
+#endif
+
 static void flash_init(void)
 {
 #if ON_TILE(FLASH_TILE_NO)
-    fl_QuadDeviceSpec qspi_spec[2] = {FL_QUADDEVICE_W25Q32JV, FL_QUADDEVICE_ZB25VQ32D};
+    fl_QuadDeviceSpec qspi_spec[FFVA_QSPI_SPEC_COUNT] = FFVA_QSPI_SPECS;
     fl_QSPIPorts qspi_ports = {
         .qspiCS = PORT_SQI_CS,
         .qspiSCLK = PORT_SQI_SCLK,
@@ -55,7 +91,7 @@ static void flash_init(void)
     };
 
     // try to connect to spi flash and set the boot part
-    xassert(fl_connectToDevice(&qspi_ports, qspi_spec, 2) == 0);
+    xassert(fl_connectToDevice(&qspi_ports, qspi_spec, FFVA_QSPI_SPEC_COUNT) == 0);
     // We have 4MB SPI Flash, 2MB for firmware storage and 2MB for data storage
     fl_setBootPartitionSize(0x200000);
 
@@ -63,7 +99,7 @@ static void flash_init(void)
             dfu_image_ctx,
             &qspi_ports,
             qspi_spec,
-            2);
+            FFVA_QSPI_SPEC_COUNT);
 
     rtos_qspi_flash_init(
             qspi_flash_ctx,
diff --git a/src/ffva/src/app_conf.h b/src/ffva/src/app_conf.h
index 79dcd74..0ae1afa 100644
--- a/src/ffva/src/app_conf.h
+++ b/src/ffva/src/app_conf.h
@@ -17,7 +17,9 @@
 #define APP_VERSION_MINOR   3
 #endif
 #ifndef APP_VERSION_PATCH
-#define APP_VERSION_PATCH   1
+/* 101: the aec-both-mics branch (PIPELINE_STAGE_AEC_MIC0), so ESPHome's voice_kit
+ * installs it over a stock 1.3.1 and reinstalls 1.3.1 when asked to. */
+#define APP_VERSION_PATCH   101
 #endif
 
 /* Intertile port settings */
diff --git a/src/ffva/src/configuration/configuration_servicer.h b/src/ffva/src/configuration/configuration_servicer.h
index 0624494..87fb0c7 100644
--- a/src/ffva/src/configuration/configuration_servicer.h
+++ b/src/ffva/src/configuration/configuration_servicer.h
@@ -26,6 +26,7 @@ enum e_pipeline_processing_stages
     PIPELINE_STAGE_IC = 2,
     PIPELINE_STAGE_NS = 3,
     PIPELINE_STAGE_AGC = 4,
+    PIPELINE_STAGE_AEC_MIC0 = 5,   // mic 0 with AEC applied (PIPELINE_STAGE_AEC is mic 1's)
 };
 // typedef struct {
 //     uint8_t hdr;
diff --git a/src/ffva/src/main.c b/src/ffva/src/main.c
index a7b100d..9c1d76c 100644
--- a/src/ffva/src/main.c
+++ b/src/ffva/src/main.c
@@ -166,6 +166,7 @@ int audio_pipeline_output(void *output_app_data,
         // tmp[j][1] = *(tmpptr+j+(3*frame_count));    // ref 1, overwritten by NS audio
         // tmp[j][0] = *(tmpptr+j+(4*frame_count));    // mic 0
         // tmp[j][1] = *(tmpptr+j+(5*frame_count));    // mic 1
+        // tmp[j][x] = *(tmpptr+j+(6*frame_count));    // mic 0 audio with AEC applied
 
         enum e_pipeline_processing_stages channel_0_stage = configuration_get_channel_0_stage();
         if (channel_0_stage == PIPELINE_STAGE_NONE) {
@@ -183,6 +184,9 @@ int audio_pipeline_output(void *output_app_data,
         } else if (channel_0_stage == PIPELINE_STAGE_AGC) {
             // AEC+IC+NS+AGC processed audio
             tmp[j][0] = *(tmpptr + j);
+        } else if (channel_0_stage == PIPELINE_STAGE_AEC_MIC0) {
+            // Mic 0 with AEC applied
+            tmp[j][0] = *(tmpptr + j + (6 * frame_count));
         }
 
         enum e_pipeline_processing_stages channel_1_stage = configuration_get_channel_1_stage();
@@ -201,6 +205,9 @@ int audio_pipeline_output(void *output_app_data,
         } else if (channel_1_stage == PIPELINE_STAGE_AGC) {
             // AEC+IC+NS+AGC processed audio
             tmp[j][1] = *(tmpptr + j);
+        } else if (channel_1_stage == PIPELINE_STAGE_AEC_MIC0) {
+            // Mic 0 with AEC applied
+            tmp[j][1] = *(tmpptr + j + (6 * frame_count));
         }
     }
 
