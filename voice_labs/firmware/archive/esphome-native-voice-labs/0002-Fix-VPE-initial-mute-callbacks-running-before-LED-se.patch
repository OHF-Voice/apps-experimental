From 9f5eb35a8a6968676799d950c8a9d83ec84e63c9 Mon Sep 17 00:00:00 2001
From: Michael Hansen <mike@rhasspy.org>
Date: Tue, 29 Sep 2026 13:20:58 -0500
Subject: [PATCH 2/3] Fix VPE initial mute callbacks running before LED setup

Keep microphone privacy immediate, guard all LED writes on output and light readiness, and apply the initial mute LED snapshot after hardware setup. Add regressions for both initial switch states.

Co-authored-by: Copilot App <223556219+Copilot@users.noreply.github.com>
---
 .../voice_labs/voice-preview-edition.yaml     | 52 +++++++++++++------
 .../components/voice_labs/test_vpe_example.py | 51 ++++++++++++++++++
 2 files changed, 86 insertions(+), 17 deletions(-)
 create mode 100644 tests/unit_tests/components/voice_labs/test_vpe_example.py

diff --git a/examples/voice_labs/voice-preview-edition.yaml b/examples/voice_labs/voice-preview-edition.yaml
index 62559200d1..77755d814b 100644
--- a/examples/voice_labs/voice-preview-edition.yaml
+++ b/examples/voice_labs/voice-preview-edition.yaml
@@ -4,11 +4,14 @@ esphome:
   name: voice-labs-vpe
   friendly_name: Voice Labs VPE
   on_boot:
-    priority: 375
-    then:
-      - delay: 1s
-      - switch.turn_on: internal_speaker_amp
-      - lambda: id(call_speaker).set_volume(0.5f);
+    - priority: 375
+      then:
+        - delay: 1s
+        - switch.turn_on: internal_speaker_amp
+        - lambda: id(call_speaker).set_volume(0.5f);
+    - priority: -100
+      then:
+        - script.execute: update_mute_leds
 
 esp32:
   board: esp32-s3-devkitc-1
@@ -115,14 +118,10 @@ binary_sensor:
     on_press:
       - microphone.mute: call_mics
       - voice_labs.stop: call
-      - light.turn_on:
-          id: call_leds
-          red: 100%
-          green: 0%
-          blue: 0%
+      - script.execute: update_mute_leds
     on_release:
       - microphone.unmute: call_mics
-      - light.turn_off: call_leds
+      - script.execute: update_mute_leds
   - platform: gpio
     id: call_button
     pin:
@@ -145,9 +144,30 @@ power_supply:
   - id: led_power
     pin: GPIO45
 
+script:
+  - id: update_mute_leds
+    then:
+      # GPIO initial-state callbacks run before the RMT pixel buffer is allocated.
+      - if:
+          condition:
+            lambda: return id(call_led_output).is_ready() && id(call_leds).is_ready();
+          then:
+            - if:
+                condition:
+                  binary_sensor.is_on: hardware_mute
+                then:
+                  - light.turn_on:
+                      id: call_leds
+                      red: 100%
+                      green: 0%
+                      blue: 0%
+                else:
+                  - light.turn_off: call_leds
+
 light:
   - platform: esp32_rmt_led_strip
     id: call_leds
+    output_id: call_led_output
     pin: GPIO21
     num_leds: 12
     rgb_order: GRB
@@ -187,15 +207,13 @@ voice_labs:
     - micro_wake_word.enable_model: call_stop_model
   on_end:
     - micro_wake_word.disable_model: call_stop_model
-    - if:
-        condition:
-          binary_sensor.is_off: hardware_mute
-        then:
-          - light.turn_off: call_leds
+    - script.execute: update_mute_leds
   on_feedback:
     - if:
         condition:
-          binary_sensor.is_off: hardware_mute
+          and:
+            - binary_sensor.is_off: hardware_mute
+            - lambda: return id(call_led_output).is_ready() && id(call_leds).is_ready();
         then:
           - light.turn_on:
               id: call_leds
diff --git a/tests/unit_tests/components/voice_labs/test_vpe_example.py b/tests/unit_tests/components/voice_labs/test_vpe_example.py
new file mode 100644
index 0000000000..fc1b62ffb8
--- /dev/null
+++ b/tests/unit_tests/components/voice_labs/test_vpe_example.py
@@ -0,0 +1,51 @@
+"""Regressions for VPE setup ordering, including initial GPIO mute callbacks."""
+
+from pathlib import Path
+
+import pytest
+
+import esphome
+from esphome.yaml_util import load_yaml
+
+
+@pytest.mark.parametrize("initially_muted", [False, True])
+def test_initial_mute_does_not_write_uninitialized_leds(initially_muted: bool) -> None:
+    root = Path(esphome.__file__).parent.parent
+    config = load_yaml(root / "examples/voice_labs/voice-preview-edition.yaml")
+    mute = next(
+        sensor for sensor in config["binary_sensor"] if sensor["id"] == "hardware_mute"
+    )
+    assert mute["trigger_on_initial_state"] is True
+    actions = mute["on_press" if initially_muted else "on_release"]
+    # Privacy applies immediately, independently of light setup.
+    assert actions[0] == {
+        "microphone.mute" if initially_muted else "microphone.unmute": "call_mics"
+    }
+    if initially_muted:
+        assert {"voice_labs.stop": "call"} in actions
+    assert not any(key.startswith("light.") for action in actions for key in action)
+    assert actions[-1] == {"script.execute": "update_mute_leds"}
+
+    script = next(item for item in config["script"] if item["id"] == "update_mute_leds")
+    guard = script["then"][0]["if"]
+    assert guard["condition"]["lambda"] == (
+        "return id(call_led_output).is_ready() && id(call_leds).is_ready();"
+    )
+    assert len(script["then"]) == 1
+    state = guard["then"][0]["if"]
+    assert state["condition"] == {"binary_sensor.is_on": "hardware_mute"}
+    assert state["then"][0]["light.turn_on"]["id"] == "call_leds"
+    assert state["else"] == [{"light.turn_off": "call_leds"}]
+
+    # After all hardware has set up, apply the previously skipped initial LED state.
+    assert any(
+        boot["priority"] == -100
+        and {"script.execute": "update_mute_leds"} in boot["then"]
+        for boot in config["esphome"]["on_boot"]
+    )
+    assert config["voice_labs"]["on_end"][-1] == {"script.execute": "update_mute_leds"}
+    feedback_conditions = config["voice_labs"]["on_feedback"][0]["if"]["condition"][
+        "and"
+    ]
+    assert feedback_conditions[0] == {"binary_sensor.is_off": "hardware_mute"}
+    assert feedback_conditions[1]["lambda"] == guard["condition"]["lambda"]
