#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start intent-gemma4 service
# ==============================================================================
cd /usr/src

flags=()

if bashio::config.true 'debug_logging'; then
    flags+=('--debug')
fi

export HF_HOME=/data/cache
export HF_TOKEN="$(bashio::config 'hf_token')"

mkdir -p /data/state

# Tools are auto-generated from the intent metadata + Home Assistant state.
# If /data/tools.yaml exists (e.g. saved via the web UI), it is used as a manual
# override instead.
exec python3 app.py \
    --uri 'tcp://0.0.0.0:10500' \
    --hass-token "${SUPERVISOR_TOKEN}" \
    --hass-api 'http://supervisor/core/api' \
    --http-host 0.0.0.0 \
    --http-port 5000 \
    --tools /data/tools.yaml \
    --llama-state /data/state/llama_state.bin \
    ${flags[@]}
